<div class="container">
  <div class="page-header">
    <h3><%= t('jobcomposer.showing_job_title') %></h3>
  </div>

  <p>
    <strong><%= t('jobcomposer.show_name_label') %></strong>
    <%= @workflow.name %>
  </p>

  <p>
    <strong><%= t('jobcomposer.show_batch_host_label') %></strong>
    <%= @workflow.batch_host %>
  </p>

  <p>
    <strong><%= t('jobcomposer.show_staged_dir_label') %></strong>
    <%= link_to(@workflow.staged_dir, Filesystem.new.fs(@workflow.staged_dir), target: "_blank") %>
  </p>

  <p>
    <strong><%= t('jobcomposer.show_dir_contents_label') %></strong>
  <ul>
    <% @workflow.folder_contents.each do |content| %>
        <li><%= content.path %></li>
    <% end %>
  </ul>
  </p>

  <%= link_to t('jobcomposer.back'), workflows_path, class: 'btn btn-default' %>
  <%= link_to t('jobcomposer.edit'), edit_workflow_path(@workflow), class: 'btn btn-default' %>
</div>

