<div class="page-header">
  <h2><%= t('jobcomposer.nav_templates') %> <br><small><%= t('jobcomposer.templates_subtitle') %></small></h2>
</div>

<div class="col-md-7">
  <div class="panel">
    <a class="btn btn-default btn-sm btn-info" id="new_template_button" href="<%= new_template_path %>" data-toggle="tooltip" title="<%= t('jobcomposer.new_template_title') %>" role="button"><span class="glyphicon glyphicon-plus" aria-hidden="true"></span> <%= t('jobcomposer.new_template') %></a>
    <a class="btn btn-default btn-sm btn-info" id="copy_template_button" data-toggle="tooltip" title="<%= t('jobcomposer.copy_template') %>" role="button" data-method="get" disabled><span class="glyphicon glyphicon-duplicate" aria-hidden="true"></span> <%= t('jobcomposer.copy_template') %></a>
  </div>

</div>

<div class="col-md-5">
  <!-- placeholder -->
</div>

<%# render 'form', workflow: @workflow %>

<div class="row">

  <div class="col-md-7">
    <div id="job-list-view" class="panel panel-default">
      <div class="panel-body">

        <a class="btn btn-default btn-sm btn-primary" id="open_dir_button" target="_blank" data-toggle="tooltip" title="<%= t('jobcomposer.open_dir_in_file_manager') %>" role="button" disabled>
          <span class="glyphicon glyphicon-edit" aria-hidden="true"></span> <%= t('jobcomposer.view_files') %>
        </a>
        <!--<a class="btn btn-default btn-sm btn-primary" id="edit_template_button" data-toggle="tooltip" title="Specify Template Options" role="button" data-method="get" disabled>
          <span class="glyphicon glyphicon-cog" aria-hidden="true"></span> Template Default Options
        </a>-->
        <a class="btn btn-default btn-sm btn-primary" id="terminal_button" target="_blank" data-toggle="tooltip" title="<%= t('jobcomposer.open_selected_template_in_terminal') %>" role="button" disabled>
          <span class="glyphicon glyphicon-console" aria-hidden="true"></span> <%= t('jobcomposer.open_terminal') %>
        </a>
        <a class="btn btn-danger btn-sm pull-right" id="destroy_template_button" data-toggle="tooltip" title="<%= t('jobcomposer.delete_job_title') %>" data-method="get" data-confirm="<%= t('jobcomposer.confirm_delete_template') %>" role="button" disabled>
          <span class="glyphicon glyphicon-trash" aria-hidden="true"></span> <%= t('jobcomposer.delete') %>
        </a>
      </div>

      <div class="panel-body">
        <div id="joyride-table-stop"></div>
        <table id="new-job-template-table" class="table data-table-new-job" style="width:100%">
          <thead>
            <tr>
              <th id="name-label"><%= t('jobcomposer.options_name_title') %></th>
              <th><%= t('jobcomposer.options_cluster_title') %></th>
              <th><%= t('jobcomposer.table_source') %></th>
            </tr>
          </thead>

          <tbody>
          <% @templates.each_with_index do |template, index| %>
            <tr class="job-row" tabindex="0" data-name="<%= template.name %>" data-host="<%= template.host %>" data-path="<%= template.path %>" data-script="<%= template.manifest.script %>" data-api="<%= Filesystem.new.api(template.path) %>" data-fs="<%= Filesystem.new.fs(template.path) %>" data-shell="<%= OodAppkit.shell.url(path: template.path).to_s %>" data-notes="<%= template.notes %>" <%= "data-delete=#{template.path}" unless template.system? %> >
              <td class="job-name"><%= template.name %></td>
            <td><%= template.host.titleize %></td>
            <td><%= template.source.name %></td>
          </tr>
        <% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-md-5" aria-live="polite">
    <div class="panel panel-primary">

      <div class="panel-heading">
        <h3 class="panel-title" ><%= t('jobcomposer.create_new_heading_html', name: @workflow.name) %></h3>
      </div>
      <div class="panel-body">
        <p class="text-muted" id="notes-field"></p>

        <%= bootstrap_form_for(@workflow) do |f| %>
          <%= f.alert_message t('jobcomposer.options_errors') %>

        <%= f.text_field :name, label: t('jobcomposer.job_name_label'), required: true, id: 'name-field' %>

        <%= f.select :batch_host, OODClusters.map { |cluster| [ "#{cluster.title}", cluster.id ] }, { label: t('jobcomposer.cluster_label'), prompt: t('jobcomposer.select_cluster_prompt') }, { class: "selectpicker", id: "batch_host_select", required: true } %>

        <%= f.text_field :script_name, label: t('jobcomposer.script_name_form_label'), required: true, readonly: true, id: "script-path-field" %>

        <%= f.hidden_field :staging_template_dir, required: true, id: 'staging-template-dir' %>

        <%= f.submit t('jobcomposer.create_new_job'), class: 'btn btn-primary', id: 'create-job-button' %>

        <a class="btn btn-default" id="reset-template-data" data-toggle="tooltip" title="<%= t('jobcomposer.reset_template_fields_title') %>" role="button"><%= t('jobcomposer.reset') %></a>
      <% end %>
      </div>
    </div>

    <div class="panel panel-default" id="job-details-panel">
      <div class="panel-heading">
        <h3 class="panel-title"><%= t('jobcomposer.selected_template_details') %></h3>
      </div>

      <div class="panel-body">
        <div id="template-details-view" hidden>
          <div  class="panel-body">
            <p><%= t('jobcomposer.template_location_label') %></p>
            <pre id="template-location"></pre>
          </div>
          <div class="panel-body folder-content-view">
            <p><%= t('jobcomposer.folder_contents_label') %></p>
            <span id="template-folder-contents"></span>
            <a class="btn btn-default pull-right" id="open-template-dir-button" target="_blank" data-toggle="tooltip" title="<%= t('jobcomposer.open_template_dir_in_file_manager') %>" role="button" disabled><span class="glyphicon glyphicon-new-window" aria-hidden="true"></span> <%= t('jobcomposer.open_dir') %></a>
          </div>

        </div>
      </div>
    </div>
  </div>
</div>

<ol id="joyride" style="display: none;" data-joyride>
  <li data-id="name-label">
    <p>
      First, select a template that will be used to create a new job.
    </p>
  </li>
  <li data-id="name-field">
    <p>
      Enter a name for the job you wish to create.
    </p>
  </li>
  <li data-id="batch_host_select">
    <p>
      Select the cluster where the job will be submitted.
    </p>
  </li>
  <li data-id="script-path-field">
    <p>
      Enter the name of the script that will be submitted to the batch server. (If different from default)
    </p>
  </li>
  <li data-id="create-job-button">
    <p>
      Finally, click "Create Job" to add this to your list of jobs.
    </p>
  </li>
</ol>
