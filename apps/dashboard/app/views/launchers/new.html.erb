
<div class="card col-sm-9 col-md-6 justify-self-center">
  <div class="card-body">
  <%= bootstrap_form_for(@launcher, url: project_launchers_path) do |form| %>
    <% clone_action = (action_name == 'clone') %>
    <% if clone_action %>
      <%= form.hidden_field :source_path, value: @source_path %>
    <% end %>
    
    <div class="field">
      <%= form.text_field :title, label: t('dashboard.jobs_launchers_name'), value: clone_action ? @launcher.title + t('dashboard.copy_suffix') : '' %>
    </div>

    <div class="actions d-flex justify-content-between">
      <%= form.submit t('dashboard.save'), class: 'btn btn-primary' %>

      <%= link_to t('dashboard.back'), project_path(params[:project_id]), class: 'btn btn-default',  title: t('dashboard.jobs_project_return_to_projects') %>
    </div>
  <% end %>
  </div>
</div>
