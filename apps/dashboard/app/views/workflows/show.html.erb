<%= javascript_include_tag 'workflows', nonce: true, defer: true %>

<input type="hidden" id="project-id" value="<%= @project.id %>">
<input type="hidden" id="workflow-id" value="<%= @workflow.id %>">
<input type="hidden" id="base-workflow-url" value="<%= project_workflow_path(@project.id, @workflow.id) %>">
<input type="hidden" id="base-launcher-url" value="<%= project_launchers_path(@project.id) %>">

<div id="workflows_app">
  <div class="toolbar" aria-label="<%= t('dashboard.jobs_workflow_toolbar_aria') %>">
    <% hidden_class = @workflow.editable? ? '' : 'd-none' %>
    <%= select_tag "select_launcher", options_from_collection_for_select(@launchers, :id, :title), include_blank: false, class: "form-control w-25 #{hidden_class}" %>
    <button id="btn-add" class="<%= hidden_class %>"><%= t('dashboard.jobs_workflow_add_launcher') %></button>
    <button id="btn-connect" class="<%= hidden_class %>" aria-pressed="false"><%= t('dashboard.jobs_workflow_connect_launchers') %></button>
    <button id="btn-delete-launcher" class="danger <%= hidden_class %>" title="<%= t('dashboard.jobs_workflow_delete_launcher_title') %>"><%= t('dashboard.jobs_workflow_delete_launcher') %></button>
    <button id="btn-delete-edge" class="danger <%= hidden_class %>" title="<%= t('dashboard.jobs_workflow_delete_edge_title') %>"><%= t('dashboard.jobs_workflow_delete_edge') %></button>
    <div class="workflow-actions">
      <button id="btn-submit-workflow"><%= I18n.t('dashboard.submit') %></button>
      <button id="btn-restore-workflow" class="<%= hidden_class %>"><%= I18n.t('dashboard.restore') %></button>
      <button id="btn-clear-workflow" class="<%= hidden_class %>"><%= I18n.t('dashboard.clear') %></button>
      <button id="btn-save-workflow" class="<%= hidden_class %>"><%= I18n.t('dashboard.save') %></button>
      <%= link_to I18n.t('dashboard.back'), project_path(params[:project_id]), class: 'btn btn-default align-content-center', title: t('dashboard.jobs_return_to_projects') %>
      <span class="hint <%= hidden_class %>"><%= I18n.t('dashboard.jobs_workflow_help')%></span>
    </div>
  </div>

  <div class="workspace-wrapper" id="workspace-wrapper">
    <div class="zoom-controls" id="zoom-controls" aria-label="<%= t('dashboard.jobs_workflow_zoom_controls') %>">
      <button id="zoom-in" title="<%= t('dashboard.jobs_workflow_zoom_in') %>" aria-label="<%= t('dashboard.jobs_workflow_zoom_in') %>">+</button>
      <button id="zoom-reset" title="<%= t('dashboard.jobs_workflow_zoom_reset') %>" aria-label="<%= t('dashboard.jobs_workflow_zoom_reset') %>">100%</button>
      <button id="zoom-out" title="<%= t('dashboard.jobs_workflow_zoom_out') %>" aria-label="<%= t('dashboard.jobs_workflow_zoom_out') %>">−</button>
    </div>

    <div class="workspace" id="workspace">
      <div class="stage-zoom" id="stage-zoom">
        <div class="stage" id="stage" tabindex="0" aria-label="<%= t('dashboard.jobs_workflow_canvas_aria') %>">
          <svg class="edges" id="edges" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <marker id="arrow" markerWidth="10" markerHeight="7" refX="10" refY="3.5" orient="auto">
                <polygon points="0 0, 10 3.5, 0 7"></polygon>
              </marker>
            </defs>
          </svg>
        </div>
      </div>
    </div>
  </div>
</div>
