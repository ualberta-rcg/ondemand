<footer class="footer d-flex flex-column flex-md-row flex-wrap m-0 mt-4 justify-content-between align-items-start align-items-md-center px-4 py-3 gap-2">
  <div class="d-flex flex-column align-items-start">
    <%= link_to "https://openondemand.org" do %>
      <%=
        image_tag(
          "OpenOnDemand_powered_by_RGB.svg",
          class: "footer-logo",
          alt: t('dashboard.footer_powered_by'),
          height: "40px",
        )
      %>
    <% end %>
    <div class="text-muted small mt-1">
      <%= t('dashboard.footer_open_source') %>
      <%= link_to t('dashboard.footer_contribute'), "https://github.com/OSC/ondemand", class: "text-decoration-underline" %>
    </div>
  </div>
  <span id="ood_version"><%= t('dashboard.footer_version', version: Configuration.ood_version) %><br><a href="https://openondemand.org/licensing"><%= t('dashboard.footer_license') %></a></span>
</footer>
