<% if OodLocale.supported_locales.size > 1 %>
<% current_short = OodLocale.short_label(I18n.locale) %>
<% current_full  = OodLocale.locale_name(I18n.locale) %>
<li class="nav-item dropdown" role="none" id="locale-switcher">
  <a href="#" title="<%= "#{t('dashboard.nav_language')}: #{current_full}" %>"
    aria-label="<%= "#{t('dashboard.nav_language')}: #{current_full}" %>"
    class="nav-link dropdown-toggle" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false"
    role="menuitem">
    <i class="fas fa-globe" aria-hidden="true"></i> <span><%= current_short %></span><span class="caret"></span>
  </a>

  <ul class="dropdown-menu locale-dropdown-menu <%= local_assigns.fetch(:menu_alignment, 'dropdown-menu-end') %>" role="menu">
    <% OodLocale.short_options_for_select.each do |short_name, full_name, loc, bcp47| %>
      <% active = (loc.to_sym == I18n.locale.to_sym) %>
      <li role="none">
        <%= link_to settings_path('settings[locale]' => loc, 'back' => 'true'),
                    class: "dropdown-item d-flex align-items-center py-1 px-2#{' active' if active}",
                    title: full_name,
                    aria: { label: full_name }.merge(active ? { current: 'true' } : {}),
                    lang: bcp47,
                    role: 'menuitem',
                    data: { method: 'post' } do %>
          <i class="fas <%= active ? 'fa-check' : 'fa-fw' %> fa-fw me-1" aria-hidden="true"></i>
          <span><%= short_name %></span>
        <% end %>
      </li>
    <% end %>
  </ul>
</li>
<% end %>
