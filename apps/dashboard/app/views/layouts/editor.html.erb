<%
content_for :head do
  javascript_include_tag 'editor', nonce: true
end

content_for :title do
  if @path.nil?
    t('dashboard.page_title', page: t('dashboard.file_editor'), site: @user_configuration.dashboard_title)
  else
    t('dashboard.page_title_with_dir', page: t('dashboard.file_editor'), site: @user_configuration.dashboard_title, dir: @path.basename.to_s)
  end
end
%>

<%= render template: "layouts/application", locals: { layout_container_class: 'container-fluid d-flex flex-column' } %>
