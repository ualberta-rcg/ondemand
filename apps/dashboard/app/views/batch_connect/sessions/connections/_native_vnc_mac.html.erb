<ol>
  <li><%= t('dashboard.batch_connect_sessions_native_vnc_open_terminal') %></li>
  <li>
    <% if Configuration.native_vnc_login_host %>
    <p>
      <%= t('dashboard.batch_connect_sessions_native_vnc_ssh_tunnel') %>
    </p>
    <pre><code>ssh -f -N -L <%= localport %>:<%= connect.host %>:<%= connect.port %> <%= ENV["USER"] %>@<%= Configuration.native_vnc_login_host %></code></pre>
    <% else %>
    <p>
      <%= t('dashboard.batch_connect_sessions_native_vnc_ssh_tunnel_replace_html', ssh_host: content_tag(:code, 'SSH_HOST')) %>
    </p>
    <pre><code>ssh -f -N -L <%= localport %>:<%= connect.host %>:<%= connect.port %> <%= ENV["USER"] %>@<strong>SSH_HOST</strong></code></pre>
    <% end %>
  </li>
  <% if browser.platform == :mac %>
    <li>
      <p><%= t('dashboard.batch_connect_sessions_native_vnc_mac_code') %></p>
      <pre>open vnc://:<%= connect.password %>@localhost:<%= localport %></pre>
    </li>
  <% else %>
    <li>
      <p>
        <%= t('dashboard.batch_connect_sessions_native_vnc_connect_client_html', target: content_tag(:code, "localhost:#{localport}")) %>
      </p>
    </li>
    <li>
      <p><%= t('dashboard.batch_connect_sessions_native_vnc_password') %> <code><%= connect.password %></code></p>
    </li>
  <% end %>
</ol>
