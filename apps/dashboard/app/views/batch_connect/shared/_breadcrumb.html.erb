<nav class="breadcrumb-wrapper rounded" aria-label="<%= t('dashboard.breadcrumb_aria') %>">
  <ol class="breadcrumb rounded">
    <% links.each_with_index do |link, idx| %>
      <%= tag.li class: current_page?(link) ? 'breadcrumb-item align-content-center' : 'breadcrumb-item align-content-center active' do %>
        <%= tag.a link[:text], aria: ({ current: 'page' } if (links.length - 1 == idx)), href: (link[:href] unless link.key?('href') || link[:disabled]) %>
      <% end %>
    <% end %>
  </ol>
  <ul class="breadcrumb-controls pe-3" role="toolbar" aria-label="<%= t('dashboard.page_actions_aria') %>">
    <li class="form-check form-switch" title="<%= t('dashboard.toggle_notifications') %>">
      <input
        class="form-check-input"
        type="checkbox"
        role="switch"
        id="notification_toggle"
        aria-label="<%= t('dashboard.toggle_push_notifications') %>"
      >
      <label class="form-check-label" for="notification_toggle">
        <i class="fa fa-bell" aria-hidden="true"></i>
        <span class="visually-hidden"><%= t('dashboard.toggle_push_notifications') %></span>
      </label>
    </li>
  </ul>
</nav>
